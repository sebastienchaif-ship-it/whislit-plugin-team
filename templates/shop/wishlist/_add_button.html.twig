{# "Add to Wishlist" button, shown on the product page and on every product card. #}
{% set product = hookable_metadata.context.product %}
{% set variant = product|sylius_resolve_variant %}

{% if variant is not null %}
    <form method="post"
          action="{{ path('ps_summit_wishlist_add', {'variantId': variant.id}) }}"
          class="ps-summit-wishlist-add mt-2"
          {{ sylius_test_html_attribute('wishlist-add', product.code) }}>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('ps_summit_wishlist_add') }}">
        <input type="hidden" name="_redirect" value="{{ app.request.requestUri }}">
        <button type="submit" class="btn btn-outline-secondary btn-sm">
            &#9825; {{ 'ps_summit_wishlist.ui.add_to_wishlist'|trans }}
        </button>
    </form>
{% endif %}
