{# Product card (PLP and product lists): heart over the top right corner of the image, opens the destination picker. #}
{% set product = hookable_metadata.context.product %}
{% set variant = product|sylius_resolve_variant %}

{% if variant is not null %}
    <div class="position-relative" style="height: 0; z-index: 3;">
        <form method="post"
              action="{{ path('ps_summit_wishlist_add', {'variantId': variant.id}) }}"
              class="ps-summit-wishlist-add position-absolute top-0 end-0 m-2"
              {{ sylius_test_html_attribute('wishlist-add', product.code) }}>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('ps_summit_wishlist_add') }}">
            {% include '@PsSummitSyliusWishlistPlugin/shop/wishlist/_picker.html.twig' with {
                variant: variant,
                label_suffix: product.name,
                toggle_class: 'btn btn-light rounded-circle shadow-sm p-2 lh-1 text-danger',
                picker_id: 'ps-summit-wishlist-card-' ~ product.id,
            } only %}
        </form>
    </div>
{% endif %}
