{# Product page: destination picker on the left of the native "Add to cart" button (same row).
   Its buttons target the external wishlist form (form= / formaction=). #}
{% set form = hookable_metadata.context.form %}
{% set variant = form.cartItem.vars.value.variant %}

<div class="d-flex align-items-start gap-2" {{ sylius_test_html_attribute('wishlist-add-pdp') }}>
    {% if variant is not null %}
        {% include '@PsSummitSyliusWishlistPlugin/shop/wishlist/_picker.html.twig' with {
            variant: variant,
            toggle_class: 'btn btn-outline-danger',
            form: 'ps-summit-wishlist-pdp-form',
            formaction: path('ps_summit_wishlist_add', {'variantId': variant.id}),
            picker_id: 'ps-summit-wishlist-pdp',
        } only %}
    {% endif %}
    {% include '@SyliusShop/product/show/content/info/summary/add_to_cart/submit.html.twig' %}
</div>
