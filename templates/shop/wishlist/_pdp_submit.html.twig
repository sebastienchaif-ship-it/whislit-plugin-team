{# Product page: heart on the left of the native "Add to cart" button (same row). #}
{% set form = hookable_metadata.context.form %}
{% set variant = form.cartItem.vars.value.variant %}
{% set in_wishlist = ps_summit_wishlist_has_variant(variant) %}

<div class="d-flex align-items-start gap-2">
    {% if variant is not null %}
        <button type="submit" form="ps-summit-wishlist-pdp-form"
                formaction="{{ path('ps_summit_wishlist_add', {'variantId': variant.id}) }}"
                class="btn btn-outline-danger"
                title="{{ (in_wishlist ? 'ps_summit_wishlist.ui.in_wishlist' : 'ps_summit_wishlist.ui.add_to_wishlist')|trans }}"
                aria-pressed="{{ in_wishlist ? 'true' : 'false' }}"
                    aria-label="{{ (in_wishlist ? 'ps_summit_wishlist.ui.in_wishlist' : 'ps_summit_wishlist.ui.add_to_wishlist')|trans }}"
                {{ sylius_test_html_attribute('wishlist-add-pdp') }}>
            {% include '@PsSummitSyliusWishlistPlugin/shop/wishlist/_heart_icon.html.twig' with {filled: in_wishlist} %}
        </button>
    {% endif %}
    {% include '@SyliusShop/product/show/content/info/summary/add_to_cart/submit.html.twig' %}
</div>
