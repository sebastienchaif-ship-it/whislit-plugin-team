{#
    "My wishlists" page (Stage 2). Variables: wishlists (the visitor's wishlists, oldest first; the first one is the default list).
    Create: plain "name" + "_csrf_token" (WishlistType, token id ps_summit_wishlist_create).
    The name must not be empty nor whitespace only: checked in the browser (required + pattern) and by the back end.
#}
{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ 'ps_summit_wishlist.ui.my_wishlists'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
{# Also usable as the createAction template: on a validation error, ResourceController renders it with `form` (invalid) and no `wishlists`. #}
{% set wishlists = wishlists is defined ? wishlists : ps_summit_wishlists() %}
{% set name_errors = form is defined and form.name is defined ? form.name.vars.errors : [] %}
<div class="container my-5" {{ sylius_test_html_attribute('wishlists-page') }}>
    <h1 class="h2 mb-4">{{ 'ps_summit_wishlist.ui.my_wishlists'|trans }}</h1>

    {% include '@PsSummitSyliusWishlistPlugin/shop/wishlist/_create_form.html.twig' with {form_id: 'ps-summit-wishlist-create', name_errors: name_errors} %}

    {% if wishlists is empty %}
        <div class="alert alert-light border text-center py-5" {{ sylius_test_html_attribute('wishlists-empty') }}>
            <p class="mb-3">{{ 'ps_summit_wishlist.ui.no_wishlist'|trans }}</p>
            <a href="{{ path('sylius_shop_homepage') }}" class="btn btn-primary">{{ 'ps_summit_wishlist.ui.continue_shopping'|trans }}</a>
        </div>
    {% else %}
        <div class="list-group">
            {% for list in wishlists %}
                {% set items_count = list.items|length %}
                <a href="{{ path('ps_summit_wishlist_show', {'id': list.id}) }}"
                   class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3"
                   {{ sylius_test_html_attribute('wishlist-list', list.name) }}>
                    <span class="text-danger">{% include '@PsSummitSyliusWishlistPlugin/shop/wishlist/_heart_icon.html.twig' with {filled: items_count > 0} %}</span>
                    <span class="me-auto fw-semibold">{{ list.name }}</span>
                    <span class="badge rounded-pill bg-secondary" {{ sylius_test_html_attribute('wishlist-list-count', items_count) }}>
                        {{ 'ps_summit_wishlist.ui.items_count'|trans({'%count%': items_count}) }}
                    </span>
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
